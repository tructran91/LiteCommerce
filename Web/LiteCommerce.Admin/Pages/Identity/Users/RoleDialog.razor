@using LiteCommerce.Admin.Models.Business.User

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Change role</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Changing the role signs this user out of all sessions.</MudText>
        <MudSelect T="Guid" @bind-Value="_roleId" Label="Role" Variant="Variant.Outlined" Required="true" FullWidth="true">
            @foreach (var role in Roles)
            {
                <MudSelectItem T="Guid" Value="@role.Id">@role.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Change role</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid CurrentRoleId { get; set; }
    [Parameter] public List<RoleResponse> Roles { get; set; } = new();
    private Guid _roleId;

    protected override void OnInitialized() => _roleId = CurrentRoleId;
    private void Cancel() => MudDialog.Cancel();
    private void Save() => MudDialog.Close(DialogResult.Ok(_roleId));
}
