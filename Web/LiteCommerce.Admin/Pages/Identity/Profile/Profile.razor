@page "/profile"
@using LiteCommerce.Admin.Models.Business.Profile

<PageTitle>Profile - CommerceAdmin</PageTitle>
<MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-3" />

@if (_loading)
{
    <div class="pa-12 d-flex justify-center"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
}
else if (_errorMessage is not null && _profile is null)
{
    <MudAlert Severity="Severity.Error">@_errorMessage <MudButton OnClick="LoadAsync">Try again</MudButton></MudAlert>
}
else if (_profile is not null)
{
    <MudPaper Elevation="0" Class="pa-5 mb-5 rounded-lg" Style="border:1px solid var(--mud-palette-divider)">
        <div class="d-flex flex-wrap align-center gap-4">
            <MudAvatar Color="Color.Primary" Size="Size.Large">@Initial</MudAvatar>
            <div class="flex-grow-1" style="min-width:0; overflow-wrap:anywhere">
                <MudText Typo="Typo.h5" Class="font-weight-bold">@_profile.FullName</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_profile.Email</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_profile.Role</MudChip>
        </div>
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true">
        <MudTabPanel Text="Personal information" Icon="@Icons.Material.Filled.Person">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="8">
                    <MudPaper Elevation="0" Class="pa-6 rounded-lg" Style="border:1px solid var(--mud-palette-divider)">
                        @if (_errorMessage is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert> }
                        <EditForm Model="_profileForm" OnValidSubmit="SaveProfileAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_profileForm.FullName" For="@(() => _profileForm.FullName)" Label="Full name"
                                          Variant="Variant.Outlined" MaxLength="100" Counter="100" Disabled="_saving" Class="mb-4" />
                            <MudTextField Value="@_profile.Email" Label="Email" Variant="Variant.Outlined" ReadOnly="true" Class="mb-4" />
                            <MudTextField Value="@_profile.Role" Label="Role" Variant="Variant.Outlined" ReadOnly="true" Class="mb-4" />
                            <div class="d-flex justify-end">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" StartIcon="@Icons.Material.Filled.Save">
                                    @(_saving ? "Saving..." : "Save changes")
                                </MudButton>
                            </div>
                        </EditForm>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="Sessions" Icon="@Icons.Material.Filled.Devices">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-4">
                <div><MudText Typo="Typo.h6" Class="font-weight-bold">Active sessions</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">Devices currently allowed to refresh your access.</MudText></div>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="RevokeAllSessionsAsync" Disabled="@(_sessionOperation || _sessions.Count == 0)">Revoke all</MudButton>
            </div>
            <MudPaper Elevation="0" Class="rounded-lg overflow-hidden" Style="border:1px solid var(--mud-palette-divider)">
                <MudTable Items="_sessions" Hover="true" Elevation="0" Loading="_sessionsLoading">
                    <HeaderContent><MudTh>Device</MudTh><MudTh>IP address</MudTh><MudTh>Created</MudTh><MudTh>Expires</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Device"><MudTooltip Text="@context.UserAgent"><MudText Typo="Typo.body2">@DescribeDevice(context.UserAgent)</MudText></MudTooltip></MudTd>
                        <MudTd DataLabel="IP address">@(context.IpAddress ?? "Unknown")</MudTd>
                        <MudTd DataLabel="Created">@context.CreatedDate.ToLocalTime().ToString("g")</MudTd>
                        <MudTd DataLabel="Expires">@context.Expires.ToLocalTime().ToString("g")</MudTd>
                        <MudTd Style="text-align:right"><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RevokeSessionAsync(context))" Disabled="_sessionOperation">Revoke</MudButton></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><div class="pa-8 text-center"><MudIcon Icon="@Icons.Material.Filled.DevicesOther" Size="Size.Large" Style="opacity:.3" /><MudText Class="mud-text-secondary">No active sessions.</MudText></div></NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}
