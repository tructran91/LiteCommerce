@page "/profile"
@using LiteCommerce.Admin.Models.Business.Profile

<PageTitle>@L["Profile_PageTitle"]</PageTitle>
<MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-3" />

@if (_loading)
{
    <div class="pa-12 d-flex justify-center"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
}
else if (_errorMessage is not null && _profile is null)
{
    <MudAlert Severity="Severity.Error">@_errorMessage <MudButton OnClick="LoadAsync">@L["Common_TryAgain"]</MudButton></MudAlert>
}
else if (_profile is not null)
{
    <MudPaper Elevation="0" Class="pa-5 mb-5 rounded-lg" Style="border:1px solid var(--mud-palette-divider)">
        <div class="d-flex flex-wrap align-center gap-4">
            <MudAvatar Color="Color.Primary" Size="Size.Large">@Initial</MudAvatar>
            <div class="flex-grow-1" style="min-width:0; overflow-wrap:anywhere">
                <MudText Typo="Typo.h5" Class="font-weight-bold">@_profile.FullName</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_profile.Email</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_profile.Role</MudChip>
        </div>
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true">
        <MudTabPanel Text="@L["Profile_InfoTab"]" Icon="@Icons.Material.Filled.Person">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="8">
                    <MudPaper Elevation="0" Class="pa-6 rounded-lg" Style="border:1px solid var(--mud-palette-divider)">
                        @if (_errorMessage is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert> }
                        <EditForm Model="_profileForm" OnValidSubmit="SaveProfileAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_profileForm.FullName" For="@(() => _profileForm.FullName)" Label="@L["Profile_FullName"]"
                                          Variant="Variant.Outlined" MaxLength="100" Counter="100" Disabled="_saving" Class="mb-4" />
                            <MudTextField Value="@_profile.Email" Label="@L["UserDialog_Email"]" Variant="Variant.Outlined" ReadOnly="true" Class="mb-4" />
                            <MudTextField Value="@_profile.Role" Label="@L["Role_Role"]" Variant="Variant.Outlined" ReadOnly="true" Class="mb-4" />
                            <div class="d-flex justify-end">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" StartIcon="@Icons.Material.Filled.Save">
                                    @(_saving ? L["Auth_Saving"] : L["Profile_SaveChanges"])
                                </MudButton>
                            </div>
                        </EditForm>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="@L["Profile_SessionsTab"]" Icon="@Icons.Material.Filled.Devices">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@L["Profile_ActiveSessions"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Profile_ActiveSessionsHint"]</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="RevokeAllSessionsAsync" Disabled="@(_sessionOperation || _sessions.Count == 0)">@L["Profile_RevokeAll"]</MudButton>
            </div>
            <MudPaper Elevation="0" Class="rounded-lg overflow-hidden" Style="border:1px solid var(--mud-palette-divider)">
                <MudTable Items="_sessions" Hover="true" Elevation="0" Loading="_sessionsLoading">
                    <HeaderContent>
                        <MudTh>@L["Profile_Device"]</MudTh>
                        <MudTh>@L["Profile_IpAddress"]</MudTh>
                        <MudTh>@L["Profile_Created"]</MudTh>
                        <MudTh>@L["Profile_Expires"]</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Profile_Device"]"><MudTooltip Text="@context.UserAgent"><MudText Typo="Typo.body2">@DescribeDevice(context.UserAgent)</MudText></MudTooltip></MudTd>
                        <MudTd DataLabel="@L["Profile_IpAddress"]">@(context.IpAddress ?? L["Profile_Unknown"].Value)</MudTd>
                        <MudTd DataLabel="@L["Profile_Created"]">@context.CreatedDate.ToLocalTime().ToString("g")</MudTd>
                        <MudTd DataLabel="@L["Profile_Expires"]">@context.Expires.ToLocalTime().ToString("g")</MudTd>
                        <MudTd Style="text-align:right"><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RevokeSessionAsync(context))" Disabled="_sessionOperation">@L["Profile_Revoke"]</MudButton></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><div class="pa-8 text-center"><MudIcon Icon="@Icons.Material.Filled.DevicesOther" Size="Size.Large" Style="opacity:.3" /><MudText Class="mud-text-secondary">@L["Profile_NoSessions"]</MudText></div></NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}
