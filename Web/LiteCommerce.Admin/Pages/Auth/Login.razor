@page "/login"
@attribute [AllowAnonymous]
@layout BlankLayout
@using LiteCommerce.Admin.Models.Business.Auth

<PageTitle>@L["Auth_LoginTitle"]</PageTitle>

<div class="auth-split">

    <section class="auth-hero">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">CommerceAdmin</MudText>
        </div>

        <div>
            <MudText Class="auth-hero-title mb-3">
                @L["Auth_LoginHeroTitle1"]<br />@L["Auth_LoginHeroTitle2"]
            </MudText>
            <MudText Typo="Typo.body1" Class="auth-hero-subtitle mb-8">
                @L["Auth_LoginHeroSubtitle"]
            </MudText>

            <div class="d-flex flex-column gap-5">
                @foreach (var feature in Features)
                {
                    <div class="auth-hero-feature">
                        <div class="auth-hero-feature-icon">
                            <MudIcon Icon="@feature.Icon" Size="Size.Small" />
                        </div>
                        <div>
                            <MudText Typo="Typo.body1" Class="font-weight-bold">@feature.Title</MudText>
                            <MudText Typo="Typo.body2" Style="opacity:.85">@feature.Description</MudText>
                        </div>
                    </div>
                }
            </div>
        </div>

        <MudText Typo="Typo.caption" Style="opacity:.7">
            &copy; @DateTime.Now.Year CommerceAdmin
        </MudText>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form">

            <div class="auth-logo-badge mb-5 d-flex d-md-none">
                <MudIcon Icon="@Icons.Material.Filled.Store" />
            </div>

            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">@L["Auth_WelcomeBack"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
                @L["Auth_LoginSubtitle"]
            </MudText>

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4"
                          ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
                    @_errorMessage
                </MudAlert>
            }

            <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_form.Email"
                              For="@(() => _form.Email)"
                              Label="@L["Auth_Email"]"
                              Placeholder="@L["Auth_EmailPlaceholder"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Email"
                              Immediate="true"
                              Disabled="_submitting"
                              Class="mb-4" />

                <MudTextField @bind-Value="_form.Password"
                              For="@(() => _form.Password)"
                              Label="@L["Auth_Password"]"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="@L["Auth_ShowPassword"]"
                              Immediate="true"
                              Disabled="_submitting"
                              Class="mb-2" />

                <div class="d-flex justify-end">
                    <MudLink Href="/forgot-password" Typo="Typo.body2">@L["Auth_ForgotPassword"]</MudLink>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           DropShadow="false"
                           Class="mt-4 py-3"
                           Disabled="_submitting">
                    @if (_submitting)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <span>@L["Auth_SigningIn"]</span>
                    }
                    else
                    {
                        <span>@L["Auth_SignIn"]</span>
                    }
                </MudButton>
            </EditForm>

        </div>
    </section>

</div>

@code {
    private record HeroFeature(string Icon, string Title, string Description);

    private HeroFeature[] Features = [];

    protected override void OnInitialized()
    {
        Features =
        [
            new(Icons.Material.Outlined.Inventory2, L["Auth_FeatureCatalogTitle"], L["Auth_FeatureCatalogDesc"]),
            new(Icons.Material.Outlined.PriceChange, L["Auth_FeaturePricingTitle"], L["Auth_FeaturePricingDesc"]),
            new(Icons.Material.Outlined.History, L["Auth_FeatureAuditTitle"], L["Auth_FeatureAuditDesc"])
        ];
    }
}
