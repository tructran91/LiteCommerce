@page "/change-password"
@using LiteCommerce.Admin.Models.Business.Auth

<PageTitle>@L["Auth_ChangePasswordTitle"]</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-3" />

<div class="d-flex align-center gap-3 mb-6">
    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" />
    </MudAvatar>
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold">@L["Auth_ChangePasswordHeading"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @L["Auth_ChangePasswordSubtitle"]
        </MudText>
    </div>
</div>

<MudGrid Spacing="4">

    <MudItem xs="12" md="7" lg="8">
        <MudPaper Elevation="0" Class="pa-6" Style="border:1px solid var(--mud-palette-divider)">

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-5"
                          ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
                    @_errorMessage
                </MudAlert>
            }

            <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">@L["Auth_CurrentPassword"]</MudText>

                <MudTextField @bind-Value="_form.CurrentPassword"
                              For="@(() => _form.CurrentPassword)"
                              Label="@L["Auth_CurrentPassword"]"
                              Variant="Variant.Outlined"
                              InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showCurrent ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                              OnAdornmentClick="@(() => _showCurrent = !_showCurrent)"
                              AdornmentAriaLabel="@L["Auth_ShowCurrentPassword"]"
                              Immediate="true"
                              Disabled="_submitting" />

                <MudDivider Class="my-6" />

                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">@L["Auth_NewPassword"]</MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_form.NewPassword"
                                      For="@(() => _form.NewPassword)"
                                      Label="@L["Auth_NewPassword"]"
                                      HelperText="@L["Auth_NewPasswordHelper"]"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showNew ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showNew ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                      OnAdornmentClick="@(() => _showNew = !_showNew)"
                                      AdornmentAriaLabel="@L["Auth_ShowNewPassword"]"
                                      Immediate="true"
                                      Disabled="_submitting" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_form.ConfirmPassword"
                                      For="@(() => _form.ConfirmPassword)"
                                      Label="@L["Auth_ConfirmNewPassword"]"
                                      HelperText="@L["Auth_RepeatNewPassword"]"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showNew ? InputType.Text : InputType.Password)"
                                      Immediate="true"
                                      Disabled="_submitting" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" />

                <div class="d-flex justify-end gap-2">
                    <MudButton Variant="Variant.Text" Href="/" Disabled="_submitting">@L["Common_Cancel"]</MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               DropShadow="false"
                               Disabled="_submitting">
                        @if (_submitting)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>@L["Auth_Saving"]</span>
                        }
                        else
                        {
                            <span>@L["Auth_ChangePasswordHeading"]</span>
                        }
                    </MudButton>
                </div>
            </EditForm>

        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5" lg="4">
        <MudPaper Elevation="0" Class="pa-6" Style="border:1px solid var(--mud-palette-divider)">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-4">@L["Auth_BeforeYouContinue"]</MudText>

            <div class="d-flex flex-column gap-4">
                @foreach (var tip in Tips)
                {
                    <div class="auth-tip">
                        <MudIcon Icon="@tip.Icon" Color="@tip.Color" Size="Size.Small" Class="mt-1" />
                        <div>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@tip.Title</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@tip.Description</MudText>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    private record Tip(string Icon, Color Color, string Title, string Description);

    private Tip[] Tips = [];

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override void OnInitialized()
    {
        Tips =
        [
            new(Icons.Material.Outlined.Logout, Color.Warning, L["Auth_TipSignedOutTitle"], L["Auth_TipSignedOutDesc"]),
            new(Icons.Material.Outlined.Devices, Color.Info, L["Auth_TipOtherDevicesTitle"], L["Auth_TipOtherDevicesDesc"]),
            new(Icons.Material.Outlined.Shield, Color.Success, L["Auth_TipStrongTitle"], L["Auth_TipStrongDesc"])
        ];

        _breadcrumbs =
        [
            new(L["Common_Home"], href: "/", icon: Icons.Material.Filled.Home),
            new(L["Auth_ChangePasswordHeading"], href: null, disabled: true)
        ];
    }
}
