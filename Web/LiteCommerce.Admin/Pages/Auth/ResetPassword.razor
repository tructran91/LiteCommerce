@page "/reset-password"
@attribute [AllowAnonymous]
@layout BlankLayout
@using LiteCommerce.Admin.Models.Business.Auth

<PageTitle>@L["Auth_ResetTitle"]</PageTitle>
<div class="auth-split">
    <section class="auth-hero">
        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Store" /><MudText Typo="Typo.h6" Class="font-weight-bold">CommerceAdmin</MudText></div>
        <div><MudText Class="auth-hero-title mb-3">@L["Auth_ResetHeroTitle1"]<br />@L["Auth_ResetHeroTitle2"]</MudText><MudText Typo="Typo.body1" Class="auth-hero-subtitle">@L["Auth_ResetHeroSubtitle"]</MudText></div>
        <MudText Typo="Typo.caption" Style="opacity:.7">&copy; @DateTime.Now.Year CommerceAdmin</MudText>
    </section>
    <section class="auth-form-panel">
        <div class="auth-form">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">@L["Auth_ResetHeading"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@L["Auth_ResetInstruction"]</MudText>
            @if (_success)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-5">@L["Auth_ResetSuccess"]</MudAlert>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">@L["Auth_SignIn"]</MudButton>
            }
            else if (string.IsNullOrWhiteSpace(Token))
            {
                <MudAlert Severity="Severity.Error" Class="mb-5">@L["Auth_ResetInvalidLink"]</MudAlert>
                <MudButton Href="/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">@L["Auth_RequestAnotherLink"]</MudButton>
            }
            else
            {
                @if (_errorMessage is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert> }
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_form.NewPassword" For="@(() => _form.NewPassword)" Label="@L["Auth_NewPassword"]" Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)" Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)" Disabled="_submitting" Class="mb-4" />
                    <MudTextField @bind-Value="_form.ConfirmPassword" For="@(() => _form.ConfirmPassword)" Label="@L["Auth_ConfirmPassword"]" Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)" Disabled="_submitting" Class="mb-4" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_submitting">
                        @(_submitting ? L["Auth_Resetting"] : L["Auth_ResetHeading"])
                    </MudButton>
                    <MudButton Href="/forgot-password" Variant="Variant.Text" FullWidth="true" Class="mt-3">@L["Auth_RequestAnotherLink"]</MudButton>
                </EditForm>
            }
        </div>
    </section>
</div>
