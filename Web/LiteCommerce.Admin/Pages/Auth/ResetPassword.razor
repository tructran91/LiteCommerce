@page "/reset-password"
@attribute [AllowAnonymous]
@layout BlankLayout
@using LiteCommerce.Admin.Models.Business.Auth

<PageTitle>Reset password - CommerceAdmin</PageTitle>
<div class="auth-split">
    <section class="auth-hero">
        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Store" /><MudText Typo="Typo.h6" Class="font-weight-bold">CommerceAdmin</MudText></div>
        <div><MudText Class="auth-hero-title mb-3">Choose a new,<br />strong password.</MudText><MudText Typo="Typo.body1" Class="auth-hero-subtitle">Reset links expire after 30 minutes and can only be used once.</MudText></div>
        <MudText Typo="Typo.caption" Style="opacity:.7">&copy; @DateTime.Now.Year CommerceAdmin</MudText>
    </section>
    <section class="auth-form-panel">
        <div class="auth-form">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">Reset password</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">Enter and confirm your new password.</MudText>
            @if (_success)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-5">Password reset successfully. You can now sign in.</MudAlert>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Sign in</MudButton>
            }
            else if (string.IsNullOrWhiteSpace(Token))
            {
                <MudAlert Severity="Severity.Error" Class="mb-5">This password reset link is invalid.</MudAlert>
                <MudButton Href="/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Request another link</MudButton>
            }
            else
            {
                @if (_errorMessage is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert> }
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_form.NewPassword" For="@(() => _form.NewPassword)" Label="New password" Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)" Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)" Disabled="_submitting" Class="mb-4" />
                    <MudTextField @bind-Value="_form.ConfirmPassword" For="@(() => _form.ConfirmPassword)" Label="Confirm password" Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)" Disabled="_submitting" Class="mb-4" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_submitting">
                        @(_submitting ? "Resetting..." : "Reset password")
                    </MudButton>
                    <MudButton Href="/forgot-password" Variant="Variant.Text" FullWidth="true" Class="mt-3">Request another link</MudButton>
                </EditForm>
            }
        </div>
    </section>
</div>
