@page "/forgot-password"
@attribute [AllowAnonymous]
@layout BlankLayout
@using LiteCommerce.Admin.Models.Business.Auth

<PageTitle>Forgot password - CommerceAdmin</PageTitle>
<div class="auth-split">
    <section class="auth-hero">
        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Store" /><MudText Typo="Typo.h6" Class="font-weight-bold">CommerceAdmin</MudText></div>
        <div><MudText Class="auth-hero-title mb-3">Recover access,<br />securely.</MudText><MudText Typo="Typo.body1" Class="auth-hero-subtitle">We'll send a time-limited password reset link if your account exists.</MudText></div>
        <MudText Typo="Typo.caption" Style="opacity:.7">&copy; @DateTime.Now.Year CommerceAdmin</MudText>
    </section>
    <section class="auth-form-panel">
        <div class="auth-form">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">Forgot password?</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">Enter the email address associated with your account.</MudText>
            @if (_submitted)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-5">If the email is registered, password reset instructions have been sent.</MudAlert>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Back to sign in</MudButton>
            }
            else
            {
                @if (_errorMessage is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert> }
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_form.Email" For="@(() => _form.Email)" Label="Email" InputType="InputType.Email"
                                  Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" Disabled="_submitting" Class="mb-4" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_submitting">
                        @(_submitting ? "Sending..." : "Send reset instructions")
                    </MudButton>
                    <MudButton Href="/login" Variant="Variant.Text" FullWidth="true" Class="mt-3">Back to sign in</MudButton>
                </EditForm>
            }
        </div>
    </section>
</div>
