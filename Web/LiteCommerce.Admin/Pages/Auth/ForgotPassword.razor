@page "/forgot-password"
@attribute [AllowAnonymous]
@layout BlankLayout
@using LiteCommerce.Admin.Models.Business.Auth

<PageTitle>@L["Auth_ForgotTitle"]</PageTitle>
<div class="auth-split">
    <section class="auth-hero">
        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Store" /><MudText Typo="Typo.h6" Class="font-weight-bold">CommerceAdmin</MudText></div>
        <div><MudText Class="auth-hero-title mb-3">@L["Auth_RecoverAccessTitle1"]<br />@L["Auth_RecoverAccessTitle2"]</MudText><MudText Typo="Typo.body1" Class="auth-hero-subtitle">@L["Auth_RecoverAccessSubtitle"]</MudText></div>
        <MudText Typo="Typo.caption" Style="opacity:.7">&copy; @DateTime.Now.Year CommerceAdmin</MudText>
    </section>
    <section class="auth-form-panel">
        <div class="auth-form">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-1">@L["Auth_ForgotPassword"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@L["Auth_ForgotSubtitle"]</MudText>
            @if (_submitted)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-5">@L["Auth_ResetSent"]</MudAlert>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">@L["Auth_BackToSignIn"]</MudButton>
            }
            else
            {
                @if (_errorMessage is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert> }
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_form.Email" For="@(() => _form.Email)" Label="@L["Auth_Email"]" InputType="InputType.Email"
                                  Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" Disabled="_submitting" Class="mb-4" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_submitting">
                        @(_submitting ? L["Auth_Sending"] : L["Auth_SendReset"])
                    </MudButton>
                    <MudButton Href="/login" Variant="Variant.Text" FullWidth="true" Class="mt-3">@L["Auth_BackToSignIn"]</MudButton>
                </EditForm>
            }
        </div>
    </section>
</div>
