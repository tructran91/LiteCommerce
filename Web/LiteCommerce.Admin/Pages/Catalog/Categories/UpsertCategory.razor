@page "/categories/add"
@page "/categories/edit/{id}"
@using LiteCommerce.Admin.Models.Business.Category

<PageTitle>@(_isEditMode ? L["Category_EditTitle"] : L["Category_AddTitle"])</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

<!-- Page Header -->
<div class="d-flex align-center justify-space-between mb-5">
    <MudText Typo="Typo.h5" Class="font-weight-bold">@(_isEditMode ? L["Category_EditTitle"] : L["Category_AddTitle"])</MudText>
</div>

<!-- Tabs -->
<MudTabs Elevation="0" Rounded="true" Border="true" Color="Color.Primary">
    <!-- General Information Tab -->
    <MudTabPanel Text="@L["Category_GeneralTab"]" Icon="@Icons.Material.Filled.Info">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudForm @ref="_form" Model="_categoryForm">
                <MudGrid>
                    <!-- Name -->
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_categoryForm.Name"
                                      Label="@L["Common_Name"]"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="@L["Category_NameRequired"]"
                                      Placeholder="@L["Category_NamePlaceholder"]"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Label" />
                    </MudItem>

                    <!-- Parent Category -->
                    <MudItem xs="12" md="6">
                        <MudSelect T="string"
                                   @bind-Value="_categoryForm.ParentId"
                                   Label="@L["Category_Parent"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Placeholder="@L["Category_None"]"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Category">
                            <MudSelectItem Value="@((string?)null)">@L["Category_None"]</MudSelectItem>
                            @foreach (var category in _basicCategories)
                            {
                                <MudSelectItem Value="@category.Id">@category.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Display Order -->
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int"
                                         @bind-Value="_categoryForm.DisplayOrder"
                                         Label="@L["Category_DisplayOrderLabel"]"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Numbers" />
                    </MudItem>

                    <!-- Description -->
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_categoryForm.Description"
                                      Label="@L["Common_Description"]"
                                      Variant="Variant.Outlined"
                                      Lines="4"
                                      Placeholder="@L["Category_DescriptionPlaceholder"]" />
                    </MudItem>

                    <!-- Meta Title -->
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_categoryForm.MetaTitle"
                                      Label="@L["Category_MetaTitle"]"
                                      Variant="Variant.Outlined"
                                      Placeholder="@L["Category_MetaTitlePlaceholder"]" />
                    </MudItem>

                    <!-- Meta Keywords -->
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_categoryForm.MetaKeywords"
                                      Label="@L["Category_MetaKeywords"]"
                                      Variant="Variant.Outlined"
                                      Placeholder="@L["Category_MetaKeywordsPlaceholder"]" />
                    </MudItem>

                    <!-- Meta Description -->
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_categoryForm.MetaDescription"
                                      Label="@L["Category_MetaDescription"]"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="@L["Category_MetaDescriptionPlaceholder"]" />
                    </MudItem>

                    <!-- Thumbnail Upload -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Category_Thumbnail"]</MudText>
                        <MudFileUpload T="IBrowserFile"
                                       Accept="image/*"
                                       OnFilesChanged="OnThumbnailSelected"
                                       MaximumFileCount="1">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    @L["Category_ChooseImage"]
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (!string.IsNullOrEmpty(_thumbnailPreviewUrl))
                        {
                            <MudPaper Elevation="0" Class="mt-3 pa-3" Style="border: 1px solid var(--mud-palette-divider)">
                                <div class="d-flex align-center gap-3">
                                    <MudImage Src="@_thumbnailPreviewUrl"
                                              Alt="@L["Category_ThumbnailPreview"]"
                                              Width="150"
                                              Height="150"
                                              ObjectFit="ObjectFit.Cover"
                                              Class="rounded" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="RemoveThumbnail" />
                                </div>
                            </MudPaper>
                        }
                    </MudItem>

                    <!-- Switches -->
                    <MudItem xs="12">
                        <MudStack>
                            <MudSwitch T="bool"
                                       @bind-Value="_categoryForm.IncludeInMenu"
                                       Label="@L["Category_IncludeInMenuLabel"]"
                                       Color="Color.Primary" />
                            <MudSwitch T="bool"
                                       @bind-Value="_categoryForm.IsPublished"
                                       Label="@L["Category_IsPublished"]"
                                       Color="Color.Primary" />
                        </MudStack>
                    </MudItem>

                    <!-- Action Buttons -->
                    <MudItem xs="12" Class="mt-4">
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="FormSubmitted"
                                       Disabled="_loading">
                                @(_loading ? L["Auth_Saving"] : L["Common_Save"])
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       OnClick="Cancel"
                                       Disabled="_loading">
                                @L["Common_Cancel"]
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    </MudTabPanel>

    <!-- Products Tab -->
    <MudTabPanel Text="@L["Category_ProductsTab"]" Icon="@Icons.Material.Filled.Inventory">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudText Typo="Typo.h6">@L["Category_ProductsTab"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                @L["Category_ProductsHint"]
            </MudText>
        </MudPaper>
    </MudTabPanel>
</MudTabs>
