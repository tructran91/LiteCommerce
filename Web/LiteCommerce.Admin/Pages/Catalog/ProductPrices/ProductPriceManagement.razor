@page "/product-prices"
@using LiteCommerce.Admin.Models.Business.ProductPrice

<PageTitle>@L["Price_Title"]</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

<!-- Page Header -->
<div class="d-flex align-center justify-space-between mb-5">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@L["Price_Title"]</MudText>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="SavePricesAsync"
               Disabled="@(_loading || _saving || !HasAnyChanges)">
        @if (_saving)
        {
            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            <span>@L["Auth_Saving"]</span>
        }
        else
        {
            <span>@L["Common_SaveChanges"]</span>
        }
    </MudButton>
</div>

<!-- Error Banner -->
@if (_errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
        <strong>@L["Common_ErrorOccurred"]</strong> @_errorMessage
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadData" Class="ml-2">
            @L["Common_TryAgain"]
        </MudButton>
    </MudAlert>
}

<!-- Changes Info -->
@if (HasAnyChanges)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.Info">
        @L["Price_UnsavedChanges", ChangedProductsCount]
    </MudAlert>
}

<!-- Data Grid -->
<MudPaper Elevation="0" Class="rounded-lg overflow-hidden" Style="border:1px solid var(--mud-palette-divider)">
    <MudTable Items="@_allPrices"
              Hover="true"
              Dense="false"
              Elevation="0"
              Loading="@_loading"
              LoadingProgressColor="Color.Primary"
              SortLabel="@L["Common_SortBy"]"
              @ref="_table">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel T="ProductPricingResponse" SortBy="@(new Func<ProductPricingResponse, object>(x => x.Name))" SortDirectionChanged="OnSortChanged">@L["Price_ProductName"]</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:180px">@L["Price_Current"]</MudTh>
            <MudTh Style="width:180px">@L["Price_Old"]</MudTh>
            <MudTh Style="width:150px">@L["Price_Special"]</MudTh>
            <MudTh Style="width:180px">@L["Price_SpecialStart"]</MudTh>
            <MudTh Style="width:180px">@L["Price_SpecialEnd"]</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="@L["Price_ProductName"]">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                               Style="font-size:0.75rem; font-weight:700">
                        @context.Name[0]
                    </MudAvatar>
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="@L["Price_Current"]">
                <MudNumericField T="decimal"
                                 Value="@context.Price"
                                 ValueChanged="@(value => OnPriceChanged(context, value))"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Step="0.01M"
                                 Format="N0"
                                 Class="@(context.HasPriceChanged ? "mud-input-outlined-warning" : "")"
                                 Style="width:100%" />
            </MudTd>
            <MudTd DataLabel="@L["Price_Old"]">
                <MudNumericField T="decimal?"
                                 Value="@context.OldPrice"
                                 ValueChanged="@(value => OnOldPriceChanged(context, value))"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Step="0.01M"
                                 Format="N0"
                                 Placeholder="@L["Price_Optional"]"
                                 Clearable="true"
                                 Class="@(context.HasOldPriceChanged ? "mud-input-outlined-warning" : "")"
                                 Style="width:100%" />
            </MudTd>
            <MudTd DataLabel="@L["Price_Special"]">
                <MudText Typo="Typo.body2">
                    @(context.SpecialPrice?.ToString("N0") ?? "-")
                </MudText>
            </MudTd>
            <MudTd DataLabel="@L["Price_SpecialStart"]">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(context.SpecialPriceStart?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                </MudText>
            </MudTd>
            <MudTd DataLabel="@L["Price_SpecialEnd"]">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(context.SpecialPriceEnd?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                </MudText>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="opacity:0.3" />
                <MudText Typo="Typo.body1" Class="mud-text-secondary">@L["Common_NoData"]</MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>
