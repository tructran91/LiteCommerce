@page "/product-templates"
@using LiteCommerce.Admin.Models.Business.ProductTemplate
@using LiteCommerce.Shared.Authorization

<PermissionGuard Permission="@AppPermissions.ProductTemplate.View" />

<PageTitle>@L["Template_Title"]</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

<!-- Page Header -->
<div class="d-flex align-center justify-space-between mb-5">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">@L["Template_Title"]</MudText>
    </div>
    <HasPermission Permission="@AppPermissions.ProductTemplate.Create">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => OpenTemplateDialog(false))"
                   Disabled="_loading">
            @L["Template_AddButton"]
        </MudButton>
    </HasPermission>
</div>

<!-- Error Banner -->
@if (_errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
        <strong>@L["Common_ErrorOccurred"]</strong> @_errorMessage
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadData" Class="ml-2">
            @L["Common_TryAgain"]
        </MudButton>
    </MudAlert>
}

<!-- Data Grid -->
<MudPaper Elevation="0" Class="rounded-lg overflow-hidden" Style="border:1px solid var(--mud-palette-divider)">
    <MudTable Items="@_allTemplates"
              Hover="true"
              Dense="false"
              Elevation="0"
              Loading="@_loading"
              LoadingProgressColor="Color.Primary"
              SortLabel="@L["Common_SortBy"]"
              @ref="_table">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel T="ProductTemplateResponse" SortBy="@(new Func<ProductTemplateResponse, object>(x => x.Name))" SortDirectionChanged="OnSortChanged">@L["Template_Name"]</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:120px; text-align:center">@L["Common_Action"]</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="@L["Template_Name"]">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                               Style="font-size:0.75rem; font-weight:700">
                        @context.Name[0]
                    </MudAvatar>
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                </div>
            </MudTd>
            <MudTd Style="text-align:center">
                <HasPermission Permission="@AppPermissions.ProductTemplate.Update">
                    <MudTooltip Text="@L["Common_Edit"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenTemplateDialog(true, context))" />
                    </MudTooltip>
                </HasPermission>
                <HasPermission Permission="@AppPermissions.ProductTemplate.Delete">
                    <MudTooltip Text="@L["Common_Delete"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => OpenDeleteConfirm(context)" />
                    </MudTooltip>
                </HasPermission>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="opacity:0.3" />
                <MudText Typo="Typo.body1" Class="mud-text-secondary">@L["Common_NoData"]</MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>
