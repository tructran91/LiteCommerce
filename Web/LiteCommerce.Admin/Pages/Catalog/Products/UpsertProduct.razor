@page "/products/add"
@page "/products/edit/{id}"
@using LiteCommerce.Admin.Models.Business.Product
@using LiteCommerce.Admin.Models.Business.Brand
@using LiteCommerce.Admin.Models.Business.Category
@using LiteCommerce.Admin.Models.Business.ProductAttribute
@using LiteCommerce.Admin.Models.Business.ProductTemplate

<PageTitle>@(_isEditMode ? L["Product_EditTitle"] : L["Product_AddTitle"])</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

<!-- Page Header -->
<div class="d-flex align-center justify-space-between mb-5">
    <MudText Typo="Typo.h5" Class="font-weight-bold">@(_isEditMode ? L["Product_EditTitle"] : L["Product_AddTitle"])</MudText>
</div>

<!-- Tabs -->
<MudTabs Elevation="0" Rounded="true" Border="true" Color="Color.Primary" KeepPanelsAlive="true">

    <!-- General Tab -->
    <MudTabPanel Text="@L["Product_GeneralTab"]" Icon="@Icons.Material.Filled.Info">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudForm @ref="_form" Model="_productForm">
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_productForm.Name"
                                      Label="@L["Common_Name"]"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="@L["Product_NameRequired"]"
                                      Placeholder="@L["Product_NamePlaceholder"]"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Label" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="string"
                                   @bind-Value="_productForm.BrandId"
                                   Label="@L["Product_Brand"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Placeholder="@L["Product_None"]"
                                   HelperText="@L["Product_Optional"]"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Business">
                            <MudSelectItem Value="@((string?)null)">@L["Product_None"]</MudSelectItem>
                            @foreach (var brand in _brands)
                            {
                                <MudSelectItem Value="@brand.Id">@brand.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="_productForm.Sku"
                                      Label="@L["Product_Sku"]"
                                      Variant="Variant.Outlined"
                                      Placeholder="@L["Product_SkuPlaceholder"]" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="_productForm.Gtin"
                                      Label="@L["Product_Gtin"]"
                                      Variant="Variant.Outlined"
                                      Placeholder="@L["Product_GtinPlaceholder"]" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Product_ShortDescription"]</MudText>
                        <div style="border:1px solid var(--mud-palette-divider); border-radius:4px">
                            <div class="short-desc">
                                <BlazoredTextEditor @ref="_shortDescriptionEditor" Placeholder="@L["Product_ShortDescriptionPlaceholder"]">
                                    <ToolbarContent>
                                        <select class="ql-header">
                                            <option selected=""></option>
                                            <option value="1"></option>
                                            <option value="2"></option>
                                        </select>
                                        <button class="ql-bold"></button>
                                        <button class="ql-italic"></button>
                                        <button class="ql-underline"></button>
                                        <button class="ql-strike"></button>
                                        <button class="ql-list" value="ordered"></button>
                                        <button class="ql-list" value="bullet"></button>
                                        <button class="ql-link"></button>
                                        <button class="ql-clean"></button>
                                    </ToolbarContent>
                                    <EditorContent></EditorContent>
                                </BlazoredTextEditor>
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Product_Description"]</MudText>
                        <div class="long-desc-container" style="border:1px solid var(--mud-palette-divider); border-radius:4px">
                            <div class="long-desc">
                                <BlazoredTextEditor @ref="_descriptionEditor" Placeholder="@L["Product_DescriptionPlaceholder"]">
                                <ToolbarContent>
                                    <select class="ql-header">
                                        <option selected=""></option>
                                        <option value="1"></option>
                                        <option value="2"></option>
                                        <option value="3"></option>
                                    </select>
                                    <button class="ql-bold"></button>
                                    <button class="ql-italic"></button>
                                    <button class="ql-underline"></button>
                                    <button class="ql-strike"></button>
                                    <button class="ql-blockquote"></button>
                                    <button class="ql-list" value="ordered"></button>
                                    <button class="ql-list" value="bullet"></button>
                                    <button class="ql-indent" value="-1"></button>
                                    <button class="ql-indent" value="+1"></button>
                                    <button class="ql-link"></button>
                                    <button class="ql-image"></button>
                                    <button class="ql-clean"></button>
                                </ToolbarContent>
                                <EditorContent></EditorContent>
                            </BlazoredTextEditor>
                        </div>
                        </div>
                    </MudItem>

                    <!-- Thumbnail Upload -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Product_ThumbnailImage"]</MudText>
                        <MudFileUpload T="IBrowserFile"
                                       Accept="image/*"
                                       OnFilesChanged="OnThumbnailSelected"
                                       MaximumFileCount="1">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           OnClick="@context.OpenFilePickerAsync">
                                    @L["Product_ChooseImage"]
                                </MudButton>
                            </CustomContent>
                            <SelectedTemplate>
                                @* Hide default chip display *@
                            </SelectedTemplate>
                        </MudFileUpload>
                        @if (!string.IsNullOrEmpty(_thumbnailPreviewUrl))
                        {
                            <MudPaper Elevation="0" Class="mt-3 pa-3" Style="border: 1px solid var(--mud-palette-divider)">
                                <div class="d-flex align-center gap-3">
                                    <MudImage Src="@_thumbnailPreviewUrl"
                                              Alt="@L["Product_ThumbnailPreview"]"
                                              Width="150" Height="150"
                                              ObjectFit="ObjectFit.Cover"
                                              Class="rounded" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="RemoveThumbnail" />
                                </div>
                            </MudPaper>
                        }
                    </MudItem>

                    <!-- Product Images -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Product_ProductImages"]</MudText>
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       Accept="image/*"
                                       OnFilesChanged="OnProductImagesSelected"
                                       MaximumFileCount="20">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Collections"
                                           OnClick="@context.OpenFilePickerAsync">
                                    @L["Product_ChooseImages"]
                                </MudButton>
                            </CustomContent>
                            <SelectedTemplate>
                                @* Hide default chip display *@
                            </SelectedTemplate>
                        </MudFileUpload>
                        @if (_productForm.ProductImages.Count > 0 || _productImagePreviewUrls.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-3 mt-3">
                                @foreach (var image in _productForm.ProductImages)
                                {
                                    var imageId = image.Id;
                                    <div style="position:relative;display:inline-block">
                                        <MudImage Src="@image.MediaUrl" Alt="@image.Caption" Width="120" Height="120" ObjectFit="ObjectFit.Cover" Class="rounded" Style="display:block;border:1px solid var(--mud-palette-divider)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       Style="position:absolute;top:2px;right:2px;z-index:10;background:rgba(255,255,255,0.9);padding:2px;min-width:unset;width:24px;height:24px"
                                                       OnClick="() => RemoveExistingProductImage(imageId)" />
                                    </div>
                                }
                                @for (var i = 0; i < _productImagePreviewUrls.Count; i++)
                                {
                                    var index = i;
                                    <div style="position:relative;display:inline-block">
                                        <MudImage Src="@_productImagePreviewUrls[index]" Alt="@L["Product_NewImage"]" Width="120" Height="120" ObjectFit="ObjectFit.Cover" Class="rounded" Style="display:block;border:1px solid var(--mud-palette-divider)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       Style="position:absolute;top:2px;right:2px;z-index:10;background:rgba(255,255,255,0.9);padding:2px;min-width:unset;width:24px;height:24px"
                                                       OnClick="() => RemoveProductImage(index)" />
                                    </div>
                                }
                            </div>
                        }
                    </MudItem>

                    <!-- Product Documents -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Product_ProductDocuments"]</MudText>
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       Accept=".pdf,.doc,.docx,.xls,.xlsx"
                                       OnFilesChanged="OnProductDocumentsSelected"
                                       MaximumFileCount="10">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.AttachFile"
                                           OnClick="@context.OpenFilePickerAsync">
                                    @L["Product_ChooseDocuments"]
                                </MudButton>
                            </CustomContent>
                            <SelectedTemplate>
                                @* Hide default chip display *@
                            </SelectedTemplate>
                        </MudFileUpload>
                        @if (_productForm.ProductDocuments.Count > 0 || _createProductForm.ProductDocuments.Count > 0)
                        {
                            <MudList T="string" Class="mt-3">
                                @foreach (var doc in _productForm.ProductDocuments)
                                {
                                    var docId = doc.Id;
                                    <MudListItem Icon="@Icons.Material.Filled.Description">
                                        <div class="d-flex align-center justify-space-between">
                                            <MudLink Href="@doc.MediaUrl" Target="_blank">@doc.Caption</MudLink>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           OnClick="() => RemoveExistingProductDocument(docId)" />
                                        </div>
                                    </MudListItem>
                                }
                                @for (var i = 0; i < _createProductForm.ProductDocuments.Count; i++)
                                {
                                    var index = i;
                                    <MudListItem Icon="@Icons.Material.Filled.Description">
                                        <div class="d-flex align-center justify-space-between">
                                            <MudText>@_createProductForm.ProductDocuments[index].Name <small class="mud-text-secondary">(@((_createProductForm.ProductDocuments[index].Size / 1024.0).ToString("N1")) KB)</small></MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           OnClick="() => RemoveProductDocument(index)" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudItem>

                    <!-- Switches -->
                    <MudItem xs="12">
                        <MudStack>
                            <MudSwitch T="bool" @bind-Value="_productForm.IsFeatured" Label="@L["Product_IsFeatured"]" Color="Color.Primary" />
                            <MudSwitch T="bool" @bind-Value="_productForm.IsPublished" Label="@L["Product_IsPublished"]" Color="Color.Primary" />
                            <MudSwitch T="bool" @bind-Value="_productForm.IsCallForPricing" Label="@L["Product_IsCallForPricing"]" Color="Color.Primary" />
                            <MudSwitch T="bool" @bind-Value="_productForm.IsAllowToOrder" Label="@L["Product_IsAllowedToOrder"]" Color="Color.Primary" />
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    </MudTabPanel>

    <!-- Pricing Tab -->
    <MudTabPanel Text="@L["Product_PricingTab"]" Icon="@Icons.Material.Filled.AttachMoney">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            @if (HasVariants)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    @L["Product_PricingLockedByVariants"]
                </MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_productForm.Price"
                                     Label="@L["Product_Price"]"
                                     Variant="Variant.Outlined"
                                     Disabled="@HasVariants"
                                     Min="0m"
                                     Format="N0"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_productForm.OldPrice"
                                     Label="@L["Product_OldPrice"]"
                                     Variant="Variant.Outlined"
                                     Disabled="@HasVariants"
                                     Min="0m"
                                     Format="N0"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_productForm.SpecialPrice"
                                     Label="@L["Product_SpecialPrice"]"
                                     Variant="Variant.Outlined"
                                     Min="0m"
                                     Format="N0"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.LocalOffer" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_productForm.SpecialPriceStart"
                                   Label="@L["Product_SpecialPriceStart"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_productForm.SpecialPriceEnd"
                                   Label="@L["Product_SpecialPriceEnd"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int"
                                     @bind-Value="_productForm.StockQuantity"
                                     Label="@L["Product_StockQuantity"]"
                                     Variant="Variant.Outlined"
                                     Disabled="@HasVariants"
                                     Min="0"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Inventory" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- Product Options Tab: declares the variant axes -->
    <MudTabPanel Text="@L["Product_OptionsTab"]" Icon="@Icons.Material.Filled.Tune">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudSelect T="string"
                               @bind-Value="_selectedAvailableOptionId"
                               Label="@L["Product_Options"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true">
                        @foreach (var option in AvailableOptions)
                        {
                            <MudSelectItem Value="@option.Id">@option.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(string.IsNullOrEmpty(_selectedAvailableOptionId) || _productForm.Options.Count >= MaxOptions)"
                               OnClick="AddOption">
                        @L["Common_Add"]
                    </MudButton>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center justify-end">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @string.Format(L["Product_OptionsLimitHint"], _productForm.Options.Count, MaxOptions)
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    @if (!_productForm.Options.Any())
                    {
                        <MudAlert Severity="Severity.Normal">@L["Product_NoOptionsYet"]</MudAlert>
                    }
                    else
                    {
                        @foreach (var option in _productForm.Options)
                        {
                            <MudPaper Elevation="1" Class="pa-4 mb-4">
                                <div class="d-flex align-center mb-3">
                                    <MudText Typo="Typo.subtitle1" Class="flex-grow-1">@option.Name</MudText>
                                    <MudSelect T="string"
                                               @bind-Value="option.DisplayType"
                                               Label="@L["Product_OptionDisplayType"]"
                                               Variant="Variant.Outlined"
                                               Dense="true"
                                               Margin="Margin.Dense"
                                               Style="max-width: 180px;">
                                        <MudSelectItem Value="@("text")">Text</MudSelectItem>
                                        <MudSelectItem Value="@("color")">Color</MudSelectItem>
                                        <MudSelectItem Value="@("image")">Image</MudSelectItem>
                                    </MudSelect>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Class="ml-2"
                                                   OnClick="@(() => RemoveOption(option))" />
                                </div>

                                <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="false">
                                    <thead>
                                        <tr>
                                            <th style="width: 35%;">@L["Product_OptionValueKey"]</th>
                                            <th style="width: 50%;">@L["Product_OptionValueDisplay"]</th>
                                            <th style="width: 15%;" class="text-center">@L["Common_Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var value in option.Values)
                                        {
                                            <tr>
                                                <td>
                                                    <MudTextField @bind-Value="value.Key"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Immediate="false"
                                                                  MaxLength="100" />
                                                </td>
                                                <td>
                                                    <MudTextField @bind-Value="value.Display"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Immediate="false"
                                                                  MaxLength="255" />
                                                </td>
                                                <td class="text-center">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => RemoveOptionValue(option, value))" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Class="mt-2"
                                           Disabled="@(option.Values.Count >= MaxValuesPerOption)"
                                           OnClick="@(() => AddOptionValue(option))">
                                    @L["Product_AddOptionValue"]
                                </MudButton>
                            </MudPaper>
                        }
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- Variants Tab: the sellable combinations -->
    <MudTabPanel Text="@L["Product_VariantsTab"]" Icon="@Icons.Material.Filled.Inventory2">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            @if (!_productForm.Options.Any())
            {
                <MudAlert Severity="Severity.Warning">@L["Product_VariantsNeedOptions"]</MudAlert>
            }
            else
            {
                <div class="d-flex align-center mb-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="GenerateVariants">
                        @L["Product_GenerateVariants"]
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="ml-4 mud-text-secondary">
                        @string.Format(L["Product_VariantsCountHint"], _productForm.Variants.Count, MaxVariants)
                    </MudText>
                </div>

                @if (!_productForm.Variants.Any())
                {
                    <MudAlert Severity="Severity.Normal">@L["Product_NoVariantsYet"]</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true">
                        <thead>
                            <tr>
                                <th style="width: 22%;">@L["Product_VariantCombination"]</th>
                                <th style="width: 18%;">@L["Product_Sku"]</th>
                                <th style="width: 17%;">@L["Product_Price"]</th>
                                <th style="width: 17%;">@L["Product_OldPrice"]</th>
                                <th style="width: 14%;">@L["Product_StockQuantity"]</th>
                                <th style="width: 7%;" class="text-center">@L["Product_VariantActive"]</th>
                                <th style="width: 5%;" class="text-center">@L["Common_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in _productForm.Variants)
                            {
                                <tr>
                                    <td>
                                        <MudText Typo="Typo.body2">@variant.CombinationLabel</MudText>
                                    </td>
                                    <td>
                                        <MudTextField @bind-Value="variant.Sku"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="false"
                                                      MaxLength="100" />
                                    </td>
                                    <td>
                                        <MudNumericField T="decimal"
                                                         @bind-Value="variant.Price"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0m"
                                                         Format="N0" />
                                    </td>
                                    <td>
                                        <MudNumericField T="decimal?"
                                                         @bind-Value="variant.OldPrice"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0m"
                                                         Format="N0"
                                                         Clearable="true" />
                                    </td>
                                    <td>
                                        <MudNumericField T="int"
                                                         @bind-Value="variant.StockQuantity"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0" />
                                    </td>
                                    <td class="text-center">
                                        <MudSwitch T="bool" @bind-Value="variant.IsActive" Color="Color.Primary" />
                                    </td>
                                    <td class="text-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveVariant(variant))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </MudPaper>
    </MudTabPanel>

    <!-- Product Attributes Tab -->
    <MudTabPanel Text="@L["Product_AttributesTab"]" Icon="@Icons.Material.Filled.ListAlt">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudGrid>
                <!-- Template selector -->
                <MudItem xs="12" md="5">
                    <MudSelect T="string"
                               @bind-Value="_selectedTemplateId"
                               Label="@L["Product_Templates"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Placeholder="@L["Product_SelectTemplate"]">
                        @foreach (var template in _productTemplates)
                        {
                            <MudSelectItem Value="@template.Id">@template.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyTemplate" FullWidth="true" Style="height:56px">@L["Product_ApplyTemplate"]</MudButton>
                </MudItem>

                <!-- Available attributes selector -->
                <MudItem xs="12" md="3">
                    <MudSelect T="string"
                               @bind-Value="_selectedAvailableAttributeId"
                               Label="@L["Product_AvailableAttributes"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Placeholder="@L["Product_SelectAttribute"]">
                        @foreach (var group in _availableAttributes.GroupBy(a => a.GroupName ?? L["Product_Ungrouped"].Value).OrderBy(g => g.Key))
                        {
                            <MudSelectGroup T="string" Title="@group.Key">
                                @foreach (var attr in group)
                                {
                                    <MudSelectItem Value="@attr.Id">@attr.Name</MudSelectItem>
                                }
                            </MudSelectGroup>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddAvailableAttribute" FullWidth="true" Style="height:56px">@L["Common_Add"]</MudButton>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="mr-1" />
                @L["Product_AttributesTab"]
                @if (_productForm.Attributes.Count > 0)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_productForm.Attributes.Count</MudChip>
                }
            </MudText>

            @if (_productForm.Attributes.Count == 0)
            {
                <MudText Class="mud-text-secondary">@L["Product_NoAttributes"]</MudText>
            }
            else
            {
                @foreach (var group in _productForm.Attributes
                    .GroupBy(a => a.GroupName ?? L["Product_Ungrouped"].Value)
                    .OrderBy(g => g.Key == L["Product_Ungrouped"].Value ? 1 : 0)
                    .ThenBy(g => g.Key))
                {
                    <MudPaper Elevation="0" Class="mb-4" Style="border: 1px solid var(--mud-palette-divider)">
                        <MudToolBar Dense="true" Class="rounded-t" Style="background: var(--mud-palette-background-gray)">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2">@group.Key</MudText>
                            <MudChip T="string" Size="Size.Small" Class="ml-2">@group.Count()</MudChip>
                        </MudToolBar>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                            <thead>
                                <tr>
                                    <th style="width:35%">@L["Product_AttributeName"]</th>
                                    <th>@L["Product_Value"]</th>
                                    <th style="width:60px; text-align:center">@L["Common_Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var attr in group)
                                {
                                    var index = _productForm.Attributes.IndexOf(attr);
                                    <tr>
                                        <td><strong>@attr.Name</strong></td>
                                        <td>
                                            <MudTextField T="string"
                                                          Value="@attr.Value"
                                                          ValueChanged="@(v => _productForm.Attributes[index].Value = v)"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </td>
                                        <td style="text-align:center">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => RemoveAttribute(attr.Id)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                }
            }
        </MudPaper>
    </MudTabPanel>

    <!-- Category Mapping Tab -->
    <MudTabPanel Text="@L["Product_CategoryMappingTab"]" Icon="@Icons.Material.Filled.Category">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            @if (_basicCategories.Count == 0)
            {
                <MudText Class="mud-text-secondary">@L["Product_NoCategories"]</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (var category in _basicCategories)
                    {
                        var isChecked = _productForm.CategoryIds.Contains(category.Id);
                        <MudItem xs="12" md="4">
                            <MudCheckBox T="bool"
                                         Value="@isChecked"
                                         ValueChanged="@(v => OnCategoryCheckedChanged(category.Id, v))"
                                         Label="@category.DisplayName"
                                         Color="Color.Primary" />
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- Related Products Tab -->
    <MudTabPanel Text="@L["Product_RelatedTab"]" Icon="@Icons.Material.Filled.Link">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudAutocomplete T="BasicProductResponse"
                             Label="@L["Product_SearchProducts"]"
                             Variant="Variant.Outlined"
                             SearchFunc="SearchRelatedProducts"
                             ToStringFunc="@(p => p?.Name ?? "")"
                             ValueChanged="AddRelatedProduct"
                             Clearable="true"
                             Dense="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" />
            @if (_productForm.RelatedProducts.Count > 0)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-1" />
                    @L["Product_RelatedTab"]
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_productForm.RelatedProducts.Count</MudChip>
                </MudText>
                @foreach (var product in _productForm.RelatedProducts)
                {
                    var productId = product.Id;
                    <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border: 1px solid var(--mud-palette-divider); border-radius:8px">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                            <MudText Class="flex-grow-1">@product.Name</MudText>
                            @if (product.IsPublished)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Product_Published"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Product_Unpublished"]</MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => RemoveRelatedProduct(productId)" />
                        </MudStack>
                    </MudPaper>
                }
            }
            else
            {
                <MudText Class="mud-text-secondary mt-4">@L["Product_NoRelated"]</MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- Cross-sell Products Tab -->
    <MudTabPanel Text="@L["Product_CrossSellTab"]" Icon="@Icons.Material.Filled.SwapHoriz">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudAutocomplete T="BasicProductResponse"
                             Label="@L["Product_SearchProducts"]"
                             Variant="Variant.Outlined"
                             SearchFunc="SearchCrossSellProducts"
                             ToStringFunc="@(p => p?.Name ?? "")"
                             ValueChanged="AddCrossSellProduct"
                             Clearable="true"
                             Dense="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" />
            @if (_productForm.CrossSellProducts.Count > 0)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-1" />
                    @L["Product_CrossSellTab"]
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_productForm.CrossSellProducts.Count</MudChip>
                </MudText>
                @foreach (var product in _productForm.CrossSellProducts)
                {
                    var productId = product.Id;
                    <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border: 1px solid var(--mud-palette-divider); border-radius:8px">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                            <MudText Class="flex-grow-1">@product.Name</MudText>
                            @if (product.IsPublished)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Product_Published"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Product_Unpublished"]</MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => RemoveCrossSellProduct(productId)" />
                        </MudStack>
                    </MudPaper>
                }
            }
            else
            {
                <MudText Class="mud-text-secondary mt-4">@L["Product_NoCrossSell"]</MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- SEO Tab -->
    <MudTabPanel Text="@L["Product_SeoTab"]" Icon="@Icons.Material.Filled.TravelExplore">
        <MudPaper Elevation="0" Class="pa-6 mt-4">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="_productForm.MetaTitle"
                                  Label="@L["Product_MetaTitle"]"
                                  Variant="Variant.Outlined"
                                  Placeholder="@L["Product_MetaTitlePlaceholder"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="_productForm.MetaKeywords"
                                  Label="@L["Product_MetaKeywords"]"
                                  Variant="Variant.Outlined"
                                  Placeholder="@L["Product_MetaKeywordsPlaceholder"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="_productForm.MetaDescription"
                                  Label="@L["Product_MetaDescription"]"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Placeholder="@L["Product_MetaDescriptionPlaceholder"]" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

<!-- Action Buttons -->
<MudPaper Elevation="0" Class="pa-4 mt-4">
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="FormSubmitted"
                   Disabled="_loading">
            @(_loading ? L["Auth_Saving"] : L["Common_Save"])
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="Cancel"
                   Disabled="_loading">
            @L["Common_Cancel"]
        </MudButton>
    </MudStack>
</MudPaper>
