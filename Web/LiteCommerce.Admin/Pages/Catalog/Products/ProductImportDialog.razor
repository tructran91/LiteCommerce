@using LiteCommerce.Admin.Helpers
@using LiteCommerce.Admin.Models.Business.Product

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FileUpload" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Product_ImportTitle"]</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Disabled="_busy"
                           OnClick="CloseDialog" />
        </div>
    </TitleContent>

    <DialogContent>
        <div class="d-flex align-center justify-center flex-wrap gap-2 mb-5">
            <div class="d-flex align-center gap-2">
                <MudAvatar Size="Size.Small" Color="@StepColor(1)" Variant="@StepVariant(1)">1</MudAvatar>
                <MudText Typo="Typo.body2" Class="@StepTextClass(1)">@L["Product_ImportStepUpload"]</MudText>
            </div>
            <MudDivider Style="width:40px; flex:0 0 40px" />
            <div class="d-flex align-center gap-2">
                <MudAvatar Size="Size.Small" Color="@StepColor(2)" Variant="@StepVariant(2)">2</MudAvatar>
                <MudText Typo="Typo.body2" Class="@StepTextClass(2)">@L["Product_ImportStepPreview"]</MudText>
            </div>
            <MudDivider Style="width:40px; flex:0 0 40px" />
            <div class="d-flex align-center gap-2">
                <MudAvatar Size="Size.Small" Color="@StepColor(3)" Variant="@StepVariant(3)">3</MudAvatar>
                <MudText Typo="Typo.body2" Class="@StepTextClass(3)">@L["Product_ImportStepResult"]</MudText>
            </div>
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">
                @_error
            </MudAlert>
        }

        @if (_busy && _step == 2)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }

        @* ---------- Step 1: upload & options ---------- *@
        @if (_step == 1)
        {
            <MudFileUpload T="IBrowserFile"
                           @ref="_fileUpload"
                           FilesChanged="OnFileSelected"
                           Accept=".xlsx,.xls"
                           MaximumFileCount="1"
                           MaxFileSize="@FileUploadSettings.MaxDocumentSize"
                           Disabled="_busy">
                <CustomContent Context="upload">
                    <div @onclick="upload.OpenFilePickerAsync" style="cursor:pointer">
                        <MudPaper Outlined="true"
                                  Class="import-dropzone d-flex flex-column align-center justify-center pa-6 rounded-lg">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Class="mt-2">@L["Product_ImportClickSelect"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error">
                                @L["Product_ImportHint", FileUploadSettings.MaxDocumentSizeMB]
                            </MudText>
                        </MudPaper>
                    </div>
                </CustomContent>
                <SelectedTemplate>
                    @* Empty on purpose: suppresses the built-in chip list; the file is rendered below. *@
                </SelectedTemplate>
            </MudFileUpload>

            <div class="d-flex align-center justify-space-between gap-2" style="min-height:40px">
                <div class="d-flex align-center gap-2" style="min-width:0">
                    @if (_fileName is not null)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Class="text-truncate">@_fileName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary flex-shrink-0">@FileSizeFormatter.Format(_fileSize)</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                       Size="Size.Small"
                                       Disabled="_busy"
                                       OnClick="ClearFileAsync" />
                    }
                </div>
                <MudLink Href="template/ProductTemplate.xlsx"
                         Target="_blank"
                         Typo="Typo.body2"
                         Class="d-flex align-center flex-shrink-0">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="mr-1" />
                    @L["Product_ImportDownloadTemplate"]
                </MudLink>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Product_ImportOptions"]</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_mode"
                               Label="@L["Product_ImportMode"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="_busy"
                               HelperText="@(_mode == ProductImportModes.SkipInvalid
                                   ? L["Product_ImportModeSkipHelper"]
                                   : L["Product_ImportModeStrictHelper"])">
                        <MudSelectItem Value="@ProductImportModes.AllOrNothing">@L["Product_ImportModeAllOrNothing"]</MudSelectItem>
                        <MudSelectItem Value="@ProductImportModes.SkipInvalid">@L["Product_ImportModeSkipInvalid"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex flex-column justify-center">
                    <MudCheckBox T="bool"
                                 @bind-Value="_createMissingBrands"
                                 Label="@L["Product_ImportCreateBrands"]"
                                 Color="Color.Primary"
                                 Dense="true"
                                 Disabled="_busy"
                                 Class="ml-n2" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary px-2">
                        @(_createMissingBrands
                            ? L["Product_ImportCreateBrandsHint"]
                            : L["Product_ImportCreateBrandsOffHint"])
                    </MudText>
                </MudItem>
            </MudGrid>
        }

        @* ---------- Step 2: preview ---------- *@
        @if (_step == 2 && _preview is not null)
        {
            @if (_preview.FileErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@L["Product_ImportFileFailed"]</MudText>
                    <ul class="mt-2 mb-0 pl-4">
                        @foreach (var fileError in _preview.FileErrors)
                        {
                            <li>
                                <MudText Typo="Typo.body2">
                                    @(string.IsNullOrWhiteSpace(fileError.Column) ? "" : $"{fileError.Column}: ")@fileError.Message
                                </MudText>
                            </li>
                        }
                    </ul>
                </MudAlert>
            }
            else if (!_preview.CanCommit)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                        <span>
                            @(_preview.ValidRows == 0
                                ? L["Product_ImportNoValidRows"]
                                : L["Product_ImportInvalidRows", _preview.InvalidRows])
                        </span>
                        @if (_mode == ProductImportModes.AllOrNothing && _preview.ValidRows > 0)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Warning"
                                       Disabled="_busy"
                                       OnClick="SwitchToSkipInvalidAsync">
                                @L["Product_ImportSwitchSkip"]
                            </MudButton>
                        }
                    </div>
                </MudAlert>
            }

            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="6" sm="3">
                    <MudPaper Outlined="true" Class="pa-3 rounded-lg text-center">
                        <MudText Typo="Typo.h5">@_preview.TotalRows</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Product_ImportTotalRows"]</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Outlined="true" Class="pa-3 rounded-lg text-center">
                        <MudText Typo="Typo.h5" Color="Color.Success">@_preview.ValidRows</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Product_ImportValid"]</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Outlined="true" Class="pa-3 rounded-lg text-center">
                        <MudText Typo="Typo.h5" Color="@(_preview.InvalidRows > 0 ? Color.Error : Color.Default)">@_preview.InvalidRows</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Product_ImportInvalid"]</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Outlined="true" Class="pa-3 rounded-lg text-center">
                        <MudText Typo="Typo.h5" Color="@(_preview.NewBrands.Count > 0 ? Color.Info : Color.Default)">@_preview.NewBrands.Count</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Product_ImportNewBrands"]</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_fileName</MudText>
                <MudSwitch T="bool"
                           @bind-Value="_onlyInvalid"
                           Label="@L["Product_ImportOnlyInvalid"]"
                           Color="Color.Primary"
                           Size="Size.Small" />
            </div>

            <MudPaper Outlined="true" Class="rounded-lg" Style="max-height:340px; overflow-y:auto">
                <MudTable Items="@VisibleRows" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="width:60px" Class="text-right">#</MudTh>
                        <MudTh Style="width:110px">@L["Product_ImportColStatus"]</MudTh>
                        <MudTh>@L["Common_Name"]</MudTh>
                        <MudTh Style="width:150px">@L["Product_ImportColBrand"]</MudTh>
                        <MudTh Style="width:190px">@L["Product_ImportColCategory"]</MudTh>
                        <MudTh Style="width:120px" Class="text-right">@L["Product_ImportColPrice"]</MudTh>
                        <MudTh>@L["Product_ImportColIssues"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#" Class="text-right">@context.RowNumber</MudTd>
                        <MudTd DataLabel="@L["Product_ImportColStatus"]">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="@(context.IsValid ? Color.Success : Color.Error)">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="@L["Common_Name"]">@context.Name</MudTd>
                        <MudTd DataLabel="@L["Product_ImportColBrand"]">
                            <div class="d-flex align-center flex-wrap gap-1">
                                <span>@(string.IsNullOrWhiteSpace(context.Brand) ? "—" : context.Brand)</span>
                                @if (context.BrandStatus == ProductImportBrandStatus.New)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@L["Product_ImportNew"]</MudChip>
                                }
                                else if (context.BrandStatus == ProductImportBrandStatus.NotFound)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">@L["Product_ImportNotFound"]</MudChip>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@L["Product_ImportColCategory"]">
                            @(context.Categories.Count > 0
                                ? string.Join(", ", context.Categories.Select(c => c.Path))
                                : context.Category ?? "—")
                        </MudTd>
                        <MudTd DataLabel="@L["Product_ImportColPrice"]" Class="text-right">@(context.Price?.ToString("#,0.##") ?? "—")</MudTd>
                        <MudTd DataLabel="@L["Product_ImportColIssues"]">
                            @if (context.Errors.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">
                                    @string.Join("; ", context.Errors.Select(e => e.Message))
                                </MudText>
                            }
                            @if (context.Warnings.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">
                                    @string.Join("; ", context.Warnings)
                                </MudText>
                            }
                            @if (context.Errors.Count == 0 && context.Warnings.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4" Align="Align.Center">@L["Product_ImportNoRows"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        }

        @* ---------- Step 3: result ---------- *@
        @if (_step == 3 && _result is not null)
        {
            <div class="d-flex flex-column align-center py-4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:56px" />
                <MudText Typo="Typo.h5" Class="mt-2">@L["Product_ImportCompleted"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 text-center">
                    @(_result.Skipped > 0
                        ? L["Product_ImportSummary", _result.Imported, _result.TotalRows, _result.Skipped]
                        : L["Product_ImportSummaryNoSkip", _result.Imported, _result.TotalRows])
                </MudText>

                @if (_result.CreatedBrands.Count > 0)
                {
                    <div class="d-flex align-center flex-wrap justify-center gap-2 mt-4">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Product_ImportBrandsCreated"]</MudText>
                        @foreach (var brand in _result.CreatedBrands)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@brand</MudChip>
                        }
                    </div>
                }
            </div>

            @if (_result.Skipped > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2">
                    <MudText Typo="Typo.body2" Class="font-weight-bold mb-1">@L["Product_ImportSkippedRows"]</MudText>
                    @foreach (var failure in _result.Errors)
                    {
                        <MudText Typo="Typo.caption">
                            @L["Product_ImportRow", failure.RowNumber, failure.Name, string.Join("; ", failure.Errors.Select(e => e.Message))]
                        </MudText>
                    }
                </MudAlert>
            }
        }
    </DialogContent>

    <DialogActions>
        @if (_step == 1)
        {
            <MudButton Variant="Variant.Outlined" OnClick="CloseDialog" Disabled="_busy">@L["Common_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="PreviewAsync"
                       Disabled="@(_busy || _fileBytes is null)">
                @(_busy ? L["Product_ImportReading"] : L["Product_ImportPreview"])
            </MudButton>
        }
        else if (_step == 2)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="BackToUpload"
                       Disabled="_busy">
                @L["Product_ImportBack"]
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DownloadReportAsync"
                       Disabled="@(_busy || _preview is null || _preview.InvalidRows == 0)">
                @L["Product_ImportErrorReport"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="CommitAsync"
                       Disabled="@(_busy || _preview is null || !_preview.CanCommit)">
                @(_busy ? L["Product_ImportImporting"] : L["Product_ImportImportRows", _preview?.ValidRows ?? 0])
            </MudButton>
        }
        else if (_step == 3)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetAsync">
                @L["Product_ImportAnother"]
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="CloseAfterImport">
                @L["Product_ImportViewProducts"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>
