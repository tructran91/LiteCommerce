@page "/audit-logs"
@using LiteCommerce.Admin.Constants
@using LiteCommerce.Admin.Models.Business.AuditLog

<PageTitle>Audit Logs</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

<!-- Page Header -->
<div class="d-flex align-center justify-space-between mb-5">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">Audit Logs</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Row-level data changes with old and new values, newest first.</MudText>
    </div>
</div>

<!-- Error Banner -->
@if (_errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
        <strong>@SystemMessages.ErrorOccurred</strong> @_errorMessage
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ApplyFilter" Class="ml-2">
            Try again
        </MudButton>
    </MudAlert>
}

<!-- Filters -->
<MudPaper Elevation="0" Class="pa-4 mb-4 rounded-lg" Style="border:1px solid var(--mud-palette-divider)">
    <MudGrid Spacing="2">
        <MudItem xs="6" md="4">
            <MudSelect T="string" @bind-Value="_query.EntityName" Label="Entity" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                @foreach (var entityName in LogConstants.AuditEntityNames)
                {
                    <MudSelectItem T="string" Value="@entityName">@entityName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudSelect T="string" @bind-Value="_query.Action" Label="Action" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                @foreach (var action in LogConstants.AuditActions)
                {
                    <MudSelectItem T="string" Value="@action">@action</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker @bind-Date="_query.FromDate" Label="From" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker @bind-Date="_query.ToDate" Label="To" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="12" Class="d-flex align-center justify-end gap-2">
            @if (!string.IsNullOrEmpty(_query.CorrelationId))
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                         OnClose="ClearCorrelationFilter">
                    Same request: @_query.CorrelationId
                </MudChip>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFilter">
                Clear
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="ApplyFilter">
                Apply
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Data Grid -->
<MudPaper Elevation="0" Class="rounded-lg overflow-hidden" Style="border:1px solid var(--mud-palette-divider)">
    <MudTable T="AuditLogResponse"
              ServerData="LoadServerData"
              Hover="true"
              Dense="true"
              Elevation="0"
              LoadingProgressColor="Color.Primary"
              @bind-RowsPerPage="_rowsPerPage"
              @ref="_table">

        <HeaderContent>
            <MudTh Style="width:180px">Time</MudTh>
            <MudTh Style="width:130px">Action</MudTh>
            <MudTh Style="width:200px">Entity</MudTh>
            <MudTh>Changed properties</MudTh>
            <MudTh Style="width:110px">User</MudTh>
            <MudTh Style="width:110px; text-align:center">Detail</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Time">
                <MudText Typo="Typo.body2">@LogConstants.ToLocalDisplay(context.Timestamp)</MudText>
            </MudTd>
            <MudTd DataLabel="Action">
                <MudChip T="string" Size="Size.Small" Color="@LogConstants.GetActionColor(context.Action)" Variant="Variant.Text">
                    @context.Action
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Entity">
                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.EntityName</MudText>
            </MudTd>
            <MudTd DataLabel="Changed properties">
                <MudText Typo="Typo.body2">@GetChangedProperties(context)</MudText>
            </MudTd>
            <MudTd DataLabel="User">
                <MudText Typo="Typo.body2">@context.UserName</MudText>
            </MudTd>
            <MudTd Style="text-align:center">
                <MudTooltip Text="View old and new values">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenDetailDialog(context))" />
                </MudTooltip>
                <MudTooltip Text="Show rows changed by the same request">
                    <MudIconButton Icon="@Icons.Material.Filled.Link"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="@(() => FilterByCorrelation(context.CorrelationId))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="opacity:0.3" />
                <MudText Typo="Typo.body1" Class="mud-text-secondary">@SystemMessages.NoData</MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="_pageSizeOptions" />
        </PagerContent>
    </MudTable>
</MudPaper>
