@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
            <MudText Typo="Typo.h6">@L["Common_ConfirmDeleteTitle"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">
            @L["Common_ConfirmDeletePrefix"] <strong>"@ItemName"</strong>@L["Common_ConfirmDeleteSuffix"]
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            @L["Common_ConfirmDeleteWarning"]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => MudDialog.Cancel())">
            @L["Common_Cancel"]
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="@(() => MudDialog.Close(DialogResult.Ok(true)))">
            @L["Common_Delete"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string ItemName { get; set; } = "";
}
