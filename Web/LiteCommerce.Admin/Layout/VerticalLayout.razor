@using LiteCommerce.Admin.Services
@using LiteCommerce.Admin.Models
@inject AppSettingsService SettingsService
@implements IDisposable

<MudLayout>
    <!-- TOP APPBAR -->
    <MudAppBar Elevation="0" Dense="false" Class="commerce-appbar">
        <MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                       Color="Color.Default"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       Class="mr-2" />

        <!-- Brand -->
        <MudText Typo="Typo.h6" Class="brand-text font-weight-bold mr-4">
            <MudIcon Icon="Icons.Material.Filled.Store" Class="mr-1 mb-1" Style="vertical-align:middle" />
            CommerceAdmin
        </MudText>

        <MudSpacer />

        <!-- Search -->
        <MudTextField T="string" Placeholder="@L["Layout_SearchPlaceholder"]"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="appbar-search d-none d-sm-flex"
                      Style="max-width:280px" />

        <MudSpacer />

        <!-- Actions -->
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Default" />
        <MudBadge Content="3" Color="Color.Error" Overlap="true" Class="mx-1">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Default" />
        </MudBadge>

        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                       Color="Color.Primary"
                       OnClick="OnSettingsClick"
                       Title="@L["Layout_SettingsTitle"]" />

        <UserMenu />
    </MudAppBar>

    <!-- SIDEBAR DRAWER -->
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               MiniWidth="72px"
               Width="260px"
               Elevation="0"
               ClipMode="DrawerClipMode.Always"
               Class="commerce-drawer">

        <MudDrawerHeader Class="drawer-header pa-4">
            @if (_drawerOpen)
            {
                <div class="d-flex align-center gap-2">
                    <MudAvatar Color="Color.Primary" Size="Size.Medium">@_initial</MudAvatar>
                    <div>
                        <MudText Typo="Typo.body1" Class="font-weight-bold" Style="line-height:1.2">@_displayName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_role</MudText>
                    </div>
                </div>
            }
            else
            {
                <MudAvatar Color="Color.Primary" Size="Size.Medium">@_initial</MudAvatar>
            }
        </MudDrawerHeader>

        <MudDivider />

        <NavMenu DrawerOpen="_drawerOpen" />

        <MudSpacer />
        <MudDivider />

        <!-- Mini toggle at bottom -->
        <div class="pa-2 d-flex justify-center">
            <MudTooltip Text="@(_drawerOpen ? L["Layout_CollapseMenu"] : L["Layout_ExpandMenu"])" Placement="Placement.Right">
                <MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)"
                               OnClick="ToggleDrawer"
                               Color="Color.Default"
                               Size="Size.Small" />
            </MudTooltip>
        </div>
    </MudDrawer>

    <!-- MAIN CONTENT -->
    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4 pa-md-6">
            @ChildContent
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnSettingsClick { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _drawerOpen = true;
    private string _displayName = string.Empty;
    private string _role = string.Empty;
    private string _initial = "?";

    protected override void OnInitialized()
    {
        SettingsService.OnSettingsChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        var email = user.FindFirst(JwtParser.EmailClaim)?.Value ?? string.Empty;

        _displayName = string.IsNullOrEmpty(email) ? L["Common_User"] : email.Split('@')[0];
        _role = user.FindFirst(JwtParser.RoleClaim)?.Value ?? string.Empty;
        _initial = _displayName[..1].ToUpperInvariant();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        SettingsService.OnSettingsChanged -= StateHasChanged;
    }
}
